datasource db {
  provider = "postgresql"
  url      = env("postgresql://postgres.pbzbgtmfrkdthgioxzaz:MAROUMMFHACKEr@2005@aws-0-us-east-2.pooler.supabase.com:5432/postgres")
}

generator client {
  provider = "prisma-client-js"
}

model Note {
  id        String     @id @default(uuid())
  text      String
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())
}

model User {
  id    String         @id @default(uuid())
  email String         @unique
  notes Note[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())
}